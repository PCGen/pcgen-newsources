# Every ability category this set declares, in load order: the base
# categories first, then the feat, background, species and class
# categories built on them.

ABILITYCATEGORY:Special Ability	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:Special Ability
ABILITYCATEGORY:Internal	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:Internal
ABILITYCATEGORY:Skill	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:Skill
ABILITYCATEGORY:Language	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:Language
ABILITYCATEGORY:Spell	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:Spell
ABILITYCATEGORY:Weapon	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:Weapon
ABILITYCATEGORY:Class	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:Class
ABILITYCATEGORY:SkillExport	VISIBLE:NO	EDITABLE:NO	EDITPOOL:NO	CATEGORY:SkillExport
ABILITYCATEGORY:Language Selection	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:YES	POOL:POOL_Language_Selection	CATEGORY:Language	TYPE:Language	PLURAL:Languages	DISPLAYLOCATION:Character
ABILITYCATEGORY:Expertise	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:NO	POOL:POOL_Expertise	CATEGORY:Special Ability	TYPE:Expertise	PLURAL:Expertise	DISPLAYLOCATION:Character
ABILITYCATEGORY:Skill Proficiency	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:NO	CATEGORY:Skill	TYPE:Skill Proficiency	PLURAL:Skill Proficiencies	DISPLAYLOCATION:Character

# Ability categories for the 2024 feat categories.
#
# The 2024 rules sort feats into Origin, General, Fighting Style and Epic Boon
# (SRD pp.87-88, which heads each group with its own name), and instruct you
# to choose from a named category. Each category therefore
# needs its own pool so a background can grant an Origin feat specifically
# rather than any feat at all.
#
# POOL: is what makes that pool exist. Without it the pool is empty, PCGen does
# not offer a category whose total pool is empty, and every feat in it is an
# object that loads perfectly and can never be chosen -- which is what all 17
# SRD feats and all 58 book feats were. The variable behind each pool is
# declared on Default in the foundation file and raised by whatever grants the
# feat: a background for an Origin feat, a class feature for the other three.
ABILITYCATEGORY:Origin Feat	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:YES	POOL:POOL_Origin_Feat	CATEGORY:FEAT	TYPE:Origin	PLURAL:Origin Feats	DISPLAYLOCATION:Feats
ABILITYCATEGORY:General Feat	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:YES	POOL:POOL_General_Feat	CATEGORY:FEAT	TYPE:General	PLURAL:General Feats	DISPLAYLOCATION:Feats
ABILITYCATEGORY:Fighting Style Feat	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:YES	POOL:POOL_Fighting_Style_Feat	CATEGORY:FEAT	TYPE:FightingStyle	PLURAL:Fighting Style Feats	DISPLAYLOCATION:Feats
ABILITYCATEGORY:Epic Boon Feat	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:YES	POOL:POOL_Epic_Boon_Feat	CATEGORY:FEAT	TYPE:EpicBoon	PLURAL:Epic Boon Feats	DISPLAYLOCATION:Feats
# What a Magic Initiate variant is spent from: a pool per spell
# list and kind, and one for the spellcasting ability it chooses.
ABILITYCATEGORY:Magic Initiate (Cleric) Cantrip	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:NO	POOL:POOL_Magic_Initiate_Cleric_Cantrip	CATEGORY:Internal	TYPE:MagicInitiateClericCantrip	PLURAL:Magic Initiate (Cleric) Cantrips	DISPLAYLOCATION:Character
ABILITYCATEGORY:Magic Initiate (Cleric) Spell	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:NO	POOL:POOL_Magic_Initiate_Cleric_Spell	CATEGORY:Internal	TYPE:MagicInitiateClericSpell	PLURAL:Magic Initiate (Cleric) Spells	DISPLAYLOCATION:Character
ABILITYCATEGORY:Magic Initiate Spellcasting Ability	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:NO	POOL:POOL_Magic_Initiate_Spellcasting_Ability	CATEGORY:Internal	TYPE:MagicInitiateSpellcastingAbility	PLURAL:Magic Initiate Spellcasting Ability	DISPLAYLOCATION:Character
ABILITYCATEGORY:Magic Initiate (Druid) Cantrip	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:NO	POOL:POOL_Magic_Initiate_Druid_Cantrip	CATEGORY:Internal	TYPE:MagicInitiateDruidCantrip	PLURAL:Magic Initiate (Druid) Cantrips	DISPLAYLOCATION:Character
ABILITYCATEGORY:Magic Initiate (Druid) Spell	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:NO	POOL:POOL_Magic_Initiate_Druid_Spell	CATEGORY:Internal	TYPE:MagicInitiateDruidSpell	PLURAL:Magic Initiate (Druid) Spells	DISPLAYLOCATION:Character
ABILITYCATEGORY:Magic Initiate (Wizard) Cantrip	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:NO	POOL:POOL_Magic_Initiate_Wizard_Cantrip	CATEGORY:Internal	TYPE:MagicInitiateWizardCantrip	PLURAL:Magic Initiate (Wizard) Cantrips	DISPLAYLOCATION:Character
ABILITYCATEGORY:Magic Initiate (Wizard) Spell	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:NO	POOL:POOL_Magic_Initiate_Wizard_Spell	CATEGORY:Internal	TYPE:MagicInitiateWizardSpell	PLURAL:Magic Initiate (Wizard) Spells	DISPLAYLOCATION:Character

# Ability category for 2024 backgrounds.
#
# A character takes exactly one background, and unlike the 2014 rules it now
# carries ability score increases and an Origin feat.
#
# Which is why the pool matters here more than anywhere else. The category had
# no POOL: and EDITPOOL:NO, so its pool was empty, PCGen does not offer a
# category whose pool is empty, and the number could not be raised by hand
# either: all four backgrounds loaded and none could be taken, and with them
# went the ability score increases and the Origin feat the 2024 rules make the
# background responsible for (SRD p.83). The pool is one, from Default in the foundation
# file, because a character has exactly one background.
ABILITYCATEGORY:Background	VISIBLE:QUALIFY	EDITABLE:YES	EDITPOOL:YES	POOL:POOL_Background	CATEGORY:Special Ability	TYPE:Background	PLURAL:Backgrounds	DISPLAYLOCATION:Character

